with Output;
with Tuning;

--  Duenner Laufzeit-Kern. Zahlen, Selektoren und Huellkurven stehen in CFG
--  und kommen aus tuning.ads. Hier gibt es keine eigenen Zeiten oder Toene.
package body Runtime is

   use Output;
   use Tuning;

   procedure Line (S : String) is
   begin
      Put_Line (S);
   end Line;

   procedure Emit_Cfg is
   begin
      Line ("var CFG = {");
      Line ("  audio: {");
      Line ("    volume: " & F (Volume, 2) & ",");
      Line ("    crossfadeMs: " & F (Crossfade_Ms, 0) & ",");
      Line ("    fadeInMs: " & F (Fade_In_Ms, 0) & "");
      Line ("  },");
      Line ("  ids: {");
      Line ("    splash: '" & Id_Splash & "',");
      Line ("    skip: '" & Id_Skip & "',");
      Line ("    sound: '" & Id_Sound & "',");
      Line ("    splashAudio: '" & Id_Splash_Audio & "',");
      Line ("    pageAudio: '" & Id_Page_Audio & "',");
      Line ("    gecko: '" & Id_Gecko & "'");
      Line ("  },");
      Line ("  cls: { on: '" & Cls_On & "', muted: '" & Cls_Muted & "' },");
      Line ("  anim: { hold: '" & Anim_Hold & "' },");
      Line ("  layout: { hideOrnaments: '(max-width: " & I (Mobile_Max) &
            "px), (pointer: coarse)' },");
      Line ("  chime: {");
      Put ("    partials: [");
      for J in Chime_Partials'Range loop
         if J > Chime_Partials'First then
            Put (", ");
         end if;
         Put (F (Chime_Partials (J), 2));
      end loop;
      Line ("],");
      Line ("    peak: " & F (Chime_Peak, 3) & ",");
      Line ("    floor: " & F (Chime_Floor, 5) & ",");
      Line ("    attack: " & F (Chime_Attack, 3) & ",");
      Line ("    release: " & F (Chime_Release, 2) & ",");
      Line ("    tail: " & F (Chime_Tail, 2) & ",");
      Put ("    map: [");
      for J in Chime_Map'Range loop
         if J > Chime_Map'First then
            Put (", ");
         end if;
         Put ("{sel:'" & Chime_Map (J).Selector.all & "', hz:" &
              F (Chime_Map (J).Hertz, 1) & "}");
      end loop;
      Line ("]");
      Line ("  },");
      Line ("  rustle: {");
      Line ("    dur: " & F (Rustle_Dur, 3) & ",");
      Line ("    freq: " & F (Rustle_Freq, 0) & ",");
      Line ("    q: " & F (Rustle_Q, 2) & ",");
      Line ("    gain: " & F (Rustle_Gain, 3) & "");
      Line ("  },");
      Line ("  gecko: {");
      Line ("    cruise: " & F (Gecko_Cruise, 1) & ",");
      Line ("    dart: " & F (Gecko_Dart, 1) & ",");
      Line ("    wanderFreq: " & F (Gecko_Wander_Freq, 2) & ",");
      Line ("    wanderAmp: " & F (Gecko_Wander_Amp, 2) & ",");
      Line ("    seekTurn: " & F (Gecko_Seek_Turn, 2) & ",");
      Line ("    dartTurn: " & F (Gecko_Dart_Turn, 2) & ",");
      Line ("    pullFar: " & F (Gecko_Pull_Far, 2) & ",");
      Line ("    pullNear: " & F (Gecko_Pull_Near, 2) & ",");
      Line ("    pullDist: " & F (Gecko_Pull_Dist, 0) & ",");
      Line ("    orbitDist: " & F (Gecko_Orbit_Dist, 0) & ",");
      Line ("    orbitFlip: " & F (Gecko_Orbit_Flip, 3) & ",");
      Line ("    orbitSide: " & F (Gecko_Orbit_Side, 2) & ",");
      Line ("    pauseRate: " & F (Gecko_Pause_Rate, 3) & ",");
      Line ("    pauseMin: " & F (Gecko_Pause_Min, 0) & ",");
      Line ("    pauseMax: " & F (Gecko_Pause_Max, 0) & ",");
      Line ("    dartRate: " & F (Gecko_Dart_Rate, 2) & ",");
      Line ("    dartMin: " & F (Gecko_Dart_Min, 0) & ",");
      Line ("    dartMax: " & F (Gecko_Dart_Max, 0) & ",");
      Line ("    legAmp: " & F (Gecko_Leg_Amp, 1) & ",");
      Line ("    legSlow: " & F (Gecko_Leg_Slow, 1) & ",");
      Line ("    legFast: " & F (Gecko_Leg_Fast, 1) & ",");
      Line ("    tailAmp: " & F (Gecko_Tail_Amp, 1) & ",");
      Line ("    tailRest: " & F (Gecko_Tail_Rest, 1) & ",");
      Line ("    tailFreq: " & F (Gecko_Tail_Freq, 2) & ",");
      Line ("    bodyAmp: " & F (Gecko_Body_Amp, 1) & ",");
      Line ("    bodyRest: " & F (Gecko_Body_Rest, 1) & ",");
      Line ("    margin: " & F (Gecko_Margin, 1) & ",");
      Line ("    startX: " & F (Gecko_Start_X, 1) & ",");
      Line ("    fromBottom: " & F (Gecko_From_Bottom, 1) & ",");
      Line ("    startHeading: " & F (Gecko_Start_Head, 2) & ",");
      Line ("    maxDt: " & F (Gecko_Max_Dt, 2) & ",");
      Line ("    cssW: " & F (Gecko_Css_W, 0) & ",");
      Line ("    cssH: " & F (Gecko_Css_H, 0) & ",");
      Line ("    moveEps: " & F (Gecko_Move_Eps, 1) & ",");
      Line ("    tapHold: " & F (Gecko_Tap_Hold, 0) & ",");
      Line ("    tapDart: " & F (Gecko_Tap_Dart, 0) & ",");
      Line ("    rustleGap: " & F (Gecko_Rustle_Gap, 0) & ",");
      Line ("    tapRustle: " & F (Gecko_Tap_Rustle, 0) & ",");
      Line ("    avoidX: " & F (Gecko_Avoid_X, 1) & ",");
      Line ("    avoidY: " & F (Gecko_Avoid_Y, 1) & ",");
      Line ("    avoidR: " & F (Gecko_Avoid_R, 1) & ",");
      Line ("    avoidTurn: " & F (Gecko_Avoid_Turn, 1) & ",");
      Line ("    tailSel: '." & Cls_Tail & "',");
      Line ("    bodySel: '." & Cls_Body & "',");
      Line ("    legSel: '." & Cls_Leg & "'");
      Line ("  }");
      Line ("};");
   end Emit_Cfg;

   procedure Emit is
   begin
      Line ("<script>");
      Line ("/* Laufzeit nur fuer Ton und Gecko. Konstanten: CFG aus dem Ada-Generator. */");
      Emit_Cfg;
      Line ("(function (CFG) {");
      Line ("  'use strict';");
      Line ("  var splash = document.getElementById(CFG.ids.splash);");
      Line ("  var skip = document.getElementById(CFG.ids.skip);");
      Line ("  var soundBtn = document.getElementById(CFG.ids.sound);");
      Line ("  var splashAudio = document.getElementById(CFG.ids.splashAudio);");
      Line ("  var pageAudio = document.getElementById(CFG.ids.pageAudio);");
      Line ("  var gecko = document.getElementById(CFG.ids.gecko);");
      Line ("  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;");
      Line ("  var hideOrnaments = window.matchMedia(CFG.layout.hideOrnaments);");
      Line ("  function ornamentsOff() { return reduce || hideOrnaments.matches; }");
      Line ("  var phase = reduce ? 'page' : 'splash';");
      Line ("  var started = false;");
      Line ("  var muted = false;");
      Line ("  var left = reduce;");
      Line ("  var splashOk = true;");
      Line ("  var pageOk = true;");
      Line ("  var fadeToken = 0;");
      Line ("  var audioCtx = null;");
      Line ("");
      Line ("  function mark (audio, which) {");
      Line ("    audio.addEventListener('error', function () {");
      Line ("      if (which === 'splash') splashOk = false; else pageOk = false;");
      Line ("    });");
      Line ("  }");
      Line ("  mark(splashAudio, 'splash');");
      Line ("  mark(pageAudio, 'page');");
      Line ("");
      Line ("  function ctx() {");
      Line ("    var AC = window.AudioContext || window.webkitAudioContext;");
      Line ("    if (!AC) return null;");
      Line ("    if (!audioCtx) audioCtx = new AC();");
      Line ("    if (audioCtx.state === 'suspended') audioCtx.resume();");
      Line ("    return audioCtx;");
      Line ("  }");
      Line ("");
      Line ("  function updateSound() {");
      Line ("    soundBtn.classList.toggle(CFG.cls.on, started && !muted);");
      Line ("    soundBtn.classList.toggle(CFG.cls.muted, muted);");
      Line ("    soundBtn.setAttribute('aria-pressed', muted ? 'true' : 'false');");
      Line ("  }");
      Line ("");
      Line ("  function safePlay(audio, which) {");
      Line ("    try {");
      Line ("      var pending = audio.play();");
      Line ("      if (pending && pending.catch) {");
      Line ("        pending.catch(function () {");
      Line ("          if (which === 'splash') splashOk = false; else pageOk = false;");
      Line ("        });");
      Line ("      }");
      Line ("    } catch (err) {");
      Line ("      if (which === 'splash') splashOk = false; else pageOk = false;");
      Line ("    }");
      Line ("  }");
      Line ("");
      Line ("  function playSplash() {");
      Line ("    if (!splashOk || muted || phase !== 'splash') return;");
      Line ("    splashAudio.volume = CFG.audio.volume;");
      Line ("    safePlay(splashAudio, 'splash');");
      Line ("  }");
      Line ("");
      Line ("  function startPage(fromSplash) {");
      Line ("    var token = ++fadeToken;");
      Line ("    var vol = CFG.audio.volume;");
      Line ("    if (!pageOk || muted) {");
      Line ("      splashAudio.volume = 0;");
      Line ("      pageAudio.volume = 0;");
      Line ("      if (!pageOk) splashAudio.pause();");
      Line ("      return;");
      Line ("    }");
      Line ("    if (fromSplash && splashOk && !splashAudio.paused) {");
      Line ("      pageAudio.volume = 0;");
      Line ("      safePlay(pageAudio, 'page');");
      Line ("      var t0 = performance.now();");
      Line ("      var ms = CFG.audio.crossfadeMs;");
      Line ("      function step(now) {");
      Line ("        if (token !== fadeToken) return;");
      Line ("        var p = Math.min(1, (now - t0) / ms);");
      Line ("        if (muted) {");
      Line ("          splashAudio.volume = 0;");
      Line ("          pageAudio.volume = 0;");
      Line ("        } else {");
      Line ("          splashAudio.volume = vol * (1 - p);");
      Line ("          pageAudio.volume = vol * p;");
      Line ("        }");
      Line ("        if (p < 1) requestAnimationFrame(step);");
      Line ("        else splashAudio.pause();");
      Line ("      }");
      Line ("      requestAnimationFrame(step);");
      Line ("    } else {");
      Line ("      splashAudio.pause();");
      Line ("      pageAudio.volume = 0;");
      Line ("      safePlay(pageAudio, 'page');");
      Line ("      var t1 = performance.now();");
      Line ("      var msIn = CFG.audio.fadeInMs;");
      Line ("      function stepIn(now) {");
      Line ("        if (token !== fadeToken) return;");
      Line ("        var p = Math.min(1, (now - t1) / msIn);");
      Line ("        pageAudio.volume = muted ? 0 : vol * p;");
      Line ("        if (p < 1) requestAnimationFrame(stepIn);");
      Line ("      }");
      Line ("      requestAnimationFrame(stepIn);");
      Line ("    }");
      Line ("  }");
      Line ("");
      Line ("  function leaveSplash() {");
      Line ("    if (left) return;");
      Line ("    left = true;");
      Line ("    var fromSplash = started && splashOk && !splashAudio.paused;");
      Line ("    phase = 'page';");
      Line ("    if (started) startPage(fromSplash);");
      Line ("    startGecko();");
      Line ("    updateSound();");
      Line ("  }");
      Line ("");
      Line ("  splash.addEventListener('animationend', function (ev) {");
      Line ("    if (ev.animationName !== CFG.anim.hold) return;");
      Line ("    leaveSplash();");
      Line ("  });");
      Line ("");
      Line ("  skip.addEventListener('change', function () {");
      Line ("    if (!skip.checked) return;");
      Line ("    started = true;");
      Line ("    leaveSplash();");
      Line ("  });");
      Line ("");
      Line ("  splash.addEventListener('click', function (ev) {");
      Line ("    if (left) return;");
      Line ("    if (ev.target.closest('.skip') || ev.target.closest('#' + CFG.ids.sound)) return;");
      Line ("    started = true;");
      Line ("    playSplash();");
      Line ("    updateSound();");
      Line ("  });");
      Line ("");
      Line ("  soundBtn.addEventListener('click', function (ev) {");
      Line ("    ev.stopPropagation();");
      Line ("    if (!started) {");
      Line ("      started = true;");
      Line ("      if (phase === 'splash') playSplash();");
      Line ("      else startPage(false);");
      Line ("      updateSound();");
      Line ("      return;");
      Line ("    }");
      Line ("    muted = !muted;");
      Line ("    fadeToken++;");
      Line ("    var vol = CFG.audio.volume;");
      Line ("    if (muted) {");
      Line ("      splashAudio.volume = 0;");
      Line ("      pageAudio.volume = 0;");
      Line ("    } else if (phase === 'splash') {");
      Line ("      splashAudio.volume = vol;");
      Line ("      if (splashAudio.paused) safePlay(splashAudio, 'splash');");
      Line ("    } else {");
      Line ("      pageAudio.volume = vol;");
      Line ("      if (pageAudio.paused) safePlay(pageAudio, 'page');");
      Line ("    }");
      Line ("    updateSound();");
      Line ("  });");
      Line ("");
      Line ("  function tone(base) {");
      Line ("    if (muted) return;");
      Line ("    var ac = ctx();");
      Line ("    if (!ac) return;");
      Line ("    var now = ac.currentTime;");
      Line ("    var spec = CFG.chime;");
      Line ("    for (var i = 0; i < spec.partials.length; i++) {");
      Line ("      var osc = ac.createOscillator();");
      Line ("      var gain = ac.createGain();");
      Line ("      osc.type = 'sine';");
      Line ("      osc.frequency.value = base * spec.partials[i];");
      Line ("      var peak = spec.peak / (i + 1);");
      Line ("      gain.gain.setValueAtTime(spec.floor, now);");
      Line ("      gain.gain.exponentialRampToValueAtTime(peak, now + spec.attack);");
      Line ("      gain.gain.exponentialRampToValueAtTime(spec.floor, now + spec.release);");
      Line ("      osc.connect(gain);");
      Line ("      gain.connect(ac.destination);");
      Line ("      osc.start(now);");
      Line ("      osc.stop(now + spec.release + spec.tail);");
      Line ("    }");
      Line ("  }");
      Line ("");
      Line ("  document.addEventListener('click', function (ev) {");
      Line ("    var map = CFG.chime.map;");
      Line ("    for (var i = 0; i < map.length; i++) {");
      Line ("      if (ev.target.closest(map[i].sel)) { tone(map[i].hz); return; }");
      Line ("    }");
      Line ("  });");
      Line ("");
      Line ("  function rustle() {");
      Line ("    if (muted || !audioCtx) return;");
      Line ("    var ac = audioCtx;");
      Line ("    var spec = CFG.rustle;");
      Line ("    var n = Math.floor(ac.sampleRate * spec.dur);");
      Line ("    if (n < 2) return;");
      Line ("    var buf = ac.createBuffer(1, n, ac.sampleRate);");
      Line ("    var data = buf.getChannelData(0);");
      Line ("    for (var i = 0; i < n; i++) {");
      Line ("      var env = 1 - i / n;");
      Line ("      data[i] = (Math.random() * 2 - 1) * env * env;");
      Line ("    }");
      Line ("    var src = ac.createBufferSource();");
      Line ("    var filter = ac.createBiquadFilter();");
      Line ("    var gain = ac.createGain();");
      Line ("    src.buffer = buf;");
      Line ("    filter.type = 'bandpass';");
      Line ("    filter.frequency.value = spec.freq;");
      Line ("    filter.Q.value = spec.q;");
      Line ("    gain.gain.value = spec.gain;");
      Line ("    src.connect(filter);");
      Line ("    filter.connect(gain);");
      Line ("    gain.connect(ac.destination);");
      Line ("    src.start();");
      Line ("  }");
      Line ("");
      Line ("  function turnTo(a, b, max) {");
      Line ("    var d = Math.atan2(Math.sin(b - a), Math.cos(b - a));");
      Line ("    if (d > max) d = max;");
      Line ("    if (d < -max) d = -max;");
      Line ("    return a + d;");
      Line ("  }");
      Line ("");
      Line ("  function startGecko() {");
      Line ("    if (ornamentsOff() || !gecko || gecko.dataset.live === '1') return;");
      Line ("    gecko.dataset.live = '1';");
      Line ("    var G = CFG.gecko;");
      Line ("    var gx = G.startX;");
      Line ("    var gy = Math.max(G.margin, window.innerHeight - G.fromBottom);");
      Line ("    var heading = G.startHeading;");
      Line ("    var wander = 0;");
      Line ("    var pauseUntil = 0;");
      Line ("    var dartUntil = 0;");
      Line ("    var orbit = 1;");
      Line ("    var pointer = null;");
      Line ("    var lastRustle = 0;");
      Line ("    var legPhase = 0;");
      Line ("    var last = performance.now();");
      Line ("    var tail = gecko.querySelector(G.tailSel);");
      Line ("    var body = gecko.querySelector(G.bodySel);");
      Line ("    var legs = gecko.querySelectorAll(G.legSel);");
      Line ("    var tailPx = tail ? +tail.getAttribute('data-px') : 0;");
      Line ("    var tailPy = tail ? +tail.getAttribute('data-py') : 0;");
      Line ("    var bodyPx = body ? +body.getAttribute('data-px') : 0;");
      Line ("    var bodyPy = body ? +body.getAttribute('data-py') : 0;");
      Line ("");
      Line ("    window.addEventListener('pointermove', function (ev) {");
      Line ("      if (ev.pointerType !== 'mouse') return;");
      Line ("      pointer = { x: ev.clientX, y: ev.clientY, until: 0 };");
      Line ("    }, { passive: true });");
      Line ("");
      Line ("    window.addEventListener('pointerdown', function (ev) {");
      Line ("      if (ev.pointerType === 'mouse') return;");
      Line ("      var now = performance.now();");
      Line ("      pointer = { x: ev.clientX, y: ev.clientY, until: now + G.tapHold };");
      Line ("      pauseUntil = 0;");
      Line ("      dartUntil = now + G.tapDart;");
      Line ("      if (now - lastRustle > G.tapRustle) { rustle(); lastRustle = now; }");
      Line ("    }, { passive: true });");
      Line ("");
      Line ("    function frame(now) {");
      Line ("      if (ornamentsOff()) { gecko.dataset.live = ''; return; }");
      Line ("      requestAnimationFrame(frame);");
      Line ("      var dt = Math.min(G.maxDt, (now - last) / 1000);");
      Line ("      last = now;");
      Line ("      if (document.hidden) return;");
      Line ("      if (pointer && pointer.until && now > pointer.until) pointer = null;");
      Line ("");
      Line ("      var speed = 0;");
      Line ("      var darting = false;");
      Line ("      if (now >= pauseUntil) {");
      Line ("        if (now >= dartUntil && Math.random() < dt * G.dartRate) {");
      Line ("          dartUntil = now + G.dartMin + Math.random() * (G.dartMax - G.dartMin);");
      Line ("          if (now - lastRustle > G.rustleGap) { rustle(); lastRustle = now; }");
      Line ("        }");
      Line ("        darting = now < dartUntil;");
      Line ("        if (!darting && Math.random() < dt * G.pauseRate) {");
      Line ("          pauseUntil = now + G.pauseMin + Math.random() * (G.pauseMax - G.pauseMin);");
      Line ("        } else {");
      Line ("          speed = darting ? G.dart : G.cruise;");
      Line ("          wander += dt * G.wanderFreq;");
      Line ("          heading += Math.sin(wander) * G.wanderAmp * dt;");
      Line ("          if (pointer) {");
      Line ("            var rect = gecko.getBoundingClientRect();");
      Line ("            var cx = rect.left + rect.width / 2;");
      Line ("            var cy = rect.top + rect.height / 2;");
      Line ("            var dx = pointer.x - cx;");
      Line ("            var dy = pointer.y - cy;");
      Line ("            var dist = Math.hypot(dx, dy) || 1;");
      Line ("            var seek = Math.atan2(dy, dx);");
      Line ("            var aim = dist < G.orbitDist ? seek + orbit * Math.PI * G.orbitSide : seek;");
      Line ("            if (Math.random() < dt * G.orbitFlip) orbit = -orbit;");
      Line ("            var pull = dist > G.pullDist ? G.pullFar : G.pullNear;");
      Line ("            var cap = (darting ? G.dartTurn : G.seekTurn) * pull * dt;");
      Line ("            heading = turnTo(heading, aim, cap);");
      Line ("          }");
      Line ("          var gw = gecko.offsetWidth || G.cssW;");
      Line ("          var gh = gecko.offsetHeight || G.cssH;");
      Line ("          var adx = gx + gw / 2 - (window.innerWidth - G.avoidX);");
      Line ("          var ady = gy + gh / 2 - G.avoidY;");
      Line ("          if (Math.hypot(adx, ady) < G.avoidR) {");
      Line ("            heading = turnTo(heading, Math.atan2(ady, adx), G.avoidTurn * dt);");
      Line ("          }");
      Line ("          gx += Math.cos(heading) * speed * dt;");
      Line ("          gy += Math.sin(heading) * speed * dt;");
      Line ("          var m = G.margin;");
      Line ("          if (gx < m) { gx = m; heading = Math.PI - heading; }");
      Line ("          if (gy < m) { gy = m; heading = -heading; }");
      Line ("          var maxX = window.innerWidth - gw - m;");
      Line ("          var maxY = window.innerHeight - gh - m;");
      Line ("          if (gx > maxX) { gx = maxX; heading = Math.PI - heading; }");
      Line ("          if (gy > maxY) { gy = maxY; heading = -heading; }");
      Line ("        }");
      Line ("      }");
      Line ("");
      Line ("      var moving = speed > G.moveEps ? 1 : 0;");
      Line ("      legPhase += dt * (darting ? G.legFast : G.legSlow) * moving;");
      Line ("      if (tail) {");
      Line ("        var ta = Math.sin(legPhase * G.tailFreq) * (G.tailRest + moving * G.tailAmp);");
      Line ("        tail.setAttribute('transform', 'rotate(' + ta.toFixed(2) + ' ' + tailPx + ' ' + tailPy + ')');");
      Line ("      }");
      Line ("      if (body) {");
      Line ("        var ba = Math.sin(legPhase) * (G.bodyRest + moving * G.bodyAmp);");
      Line ("        body.setAttribute('transform', 'rotate(' + ba.toFixed(2) + ' ' + bodyPx + ' ' + bodyPy + ')');");
      Line ("      }");
      Line ("      for (var i = 0; i < legs.length; i++) {");
      Line ("        var la = Math.sin(legPhase + (i % 2) * Math.PI) * G.legAmp * moving;");
      Line ("        legs[i].setAttribute('transform', 'rotate(' + la.toFixed(2) + ' ' +");
      Line ("          legs[i].getAttribute('data-x') + ' ' + legs[i].getAttribute('data-y') + ')');");
      Line ("      }");
      Line ("      var deg = heading * 180 / Math.PI;");
      Line ("      gecko.style.transform = 'translate(' + gx.toFixed(1) + 'px,' + gy.toFixed(1) + 'px) rotate(' + deg.toFixed(2) + 'deg)';");
      Line ("    }");
      Line ("    requestAnimationFrame(frame);");
      Line ("  }");
      Line ("");
      Line ("  updateSound();");
      Line ("})(CFG);");
      Line ("</script>");
   end Emit;

end Runtime;
